# Operating-system and editor files
.DS_Store
**/.DS_Store
*:Zone.Identifier

# Python environments and caches
**/.venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.cache/
*.nb[ci]

# Coding-agent directories can hold shared rules or skills; ignore only local
# state files (machine-local ignores live in .git/info/exclude).
.claude/settings.local.json

# Everything the code produces (~/setup layout): simulation archives, metrics,
# supplementary figures and videos. Regenerable; large arrays are never in Git.
/outputs/

# LaTeX intermediates (the collaborator-facing PDF is retained)
manuscript/*.aux
manuscript/*.fdb_latexmk
manuscript/*.fls
manuscript/*.log
manuscript/*.out
manuscript/*.synctex.gz
manuscript/*.bak

# Overleaf isolated Git metadata and project tagging (overleaf_sync)
**/.overleaf-git/
**/.overleaf_id
