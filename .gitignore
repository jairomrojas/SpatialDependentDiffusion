# Operating-system and editor files
.DS_Store
**/.DS_Store

# Python environments and caches
**/.venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/.cache/

# Coding-agent directories can hold shared rules or skills; ignore only local
# state files (machine-local ignores live in .git/info/exclude).
.claude/settings.local.json

# Reproducible heavyweight simulation outputs
simulation/results/data/
simulation/results/videos/
simulation/results/figures/frames_vs_time/

# LaTeX intermediates (the collaborator-facing PDF is retained)
manuscript/*.aux
manuscript/*.fdb_latexmk
manuscript/*.fls
manuscript/*.log
manuscript/*.out
manuscript/*.synctex.gz
manuscript/*.bak
